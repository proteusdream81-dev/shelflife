{
  "name": "Shelf",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "is_private": {
      "type": "boolean",
      "default": false
    },
    "share_enabled": {
      "type": "boolean",
      "default": false
    },
    "share_token": {
      "type": "string"
    },
    "share_audience": {
      "type": "string",
      "enum": [
        "circle",
        "selected"
      ],
      "default": "circle",
      "description": "Who a shared shelf is visible to: the reader's whole circle, or only the readers listed in shared_with_ids."
    },
    "shared_with_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "The chosen readers for a 'selected' share \u2014 the only people besides the owner who can see this shelf."
    },
    "shared_with_names": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Display names for shared_with_ids, kept in the same order."
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}