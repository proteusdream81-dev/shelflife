{
  "name": "Follow",
  "type": "object",
  "properties": {
    "follower_id": {
      "type": "string"
    },
    "follower_name": {
      "type": "string"
    },
    "following_id": {
      "type": "string"
    },
    "following_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted"
      ],
      "default": "pending",
      "description": "A new follow is a request that waits for the other reader's answer. Rows saved before requests existed carry no status and are treated as accepted."
    }
  },
  "required": [
    "follower_id",
    "following_id"
  ],
  "rls": {
    "create": {
      "data.follower_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "data.following_id": "{{user.id}}"
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.following_id": "{{user.id}}"
        }
      ]
    }
  }
}