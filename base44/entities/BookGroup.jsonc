{
  "name": "BookGroup",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "book_title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "is_private": {
      "type": "boolean",
      "default": false,
      "description": "A private group is visible only to its owner and the readers listed in member_ids."
    },
    "member_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Readers who accepted an invite \u2014 nobody is added here on the owner's say-so alone."
    },
    "blocked_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Readers the owner removed from the group \u2014 they stay out of the group chat until the owner invites them again."
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.member_ids": "{{user.id}}"
        },
        {
          "data.is_private": {
            "$ne": true
          }
        }
      ]
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}