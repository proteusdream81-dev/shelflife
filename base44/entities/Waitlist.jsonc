{
  "name": "Waitlist",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "description": "The address a reader asked to be told about the Play Store launch, lower-cased and trimmed."
    },
    "name": {
      "type": "string",
      "description": "The reader's first name, if they chose to give one, reduced to letters and the punctuation names use so it can never carry markup or a link into an email."
    },
    "source": {
      "type": "string",
      "description": "Which public surface collected the signup, so the landing page and a shared shelf can be told apart."
    },
    "founding_tester_consent": {
      "type": "boolean",
      "default": false,
      "description": "True when the reader ticked the box asking to be a Founding Tester for free early access."
    },
    "confirmed": {
      "type": "boolean",
      "default": false,
      "description": "True once someone opened the confirmation link sent to this address, which is the only proof the address belongs to the person who typed it in. The tester welcome is sent on that click and never before."
    },
    "confirm_token": {
      "type": "string",
      "description": "The one-time token in the confirmation link sent to this address. Cleared the moment it is used, so a link works once."
    },
    "confirm_sends": {
      "type": "number",
      "default": 0,
      "description": "How many confirmation emails have gone to this address inside the current day-long window. Counted on the address itself, never on the connection, so one inbox can't be written to again and again by whoever typed it in."
    },
    "confirm_last_sent_at": {
      "type": "string",
      "description": "When the last confirmation email went to this address. The count above only holds for a day from this moment, so an old count never blocks a reader who asks again much later."
    }
  },
  "required": [
    "email"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}