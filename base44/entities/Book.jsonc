{
  "name": "Book",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "isbn": {
      "type": "string"
    },
    "cover_url": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "publisher": {
      "type": "string"
    },
    "published_date": {
      "type": "string"
    },
    "page_count": {
      "type": "number"
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "buy_links": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      }
    },
    "google_books_id": {
      "type": "string"
    },
    "shelf_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "to_read",
        "reading",
        "read"
      ],
      "default": "to_read"
    },
    "notes": {
      "type": "string"
    },
    "rating": {
      "type": "number"
    },
    "format": {
      "type": "string",
      "enum": [
        "paperback",
        "hardcover",
        "ebook",
        "kindle",
        "audiobook"
      ]
    },
    "series_name": {
      "type": "string"
    },
    "series_position": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "shelf_id"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}