{
  "name": "Book",
  "type": "entity",
  "title": "Book",
  "description": "A book on a reader's shelf",
  "properties": {
    "title": { "type": "string" },
    "author": { "type": "string" },
    "isbn": { "type": "string" },
    "asin": {
      "type": "string",
      "description": "The Kindle edition's own identifier, kept when an export carried one instead of an ISBN."
    },
    "cover_url": { "type": "string" },
    "alt_covers": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Other cover art the catalogues hold for this book, kept so a shelf can show a real cover when the saved one is empty or does not load."
    },
    "description": { "type": "string" },
    "publisher": { "type": "string" },
    "published_date": { "type": "string" },
    "page_count": { "type": "number" },
    "categories": { "type": "array", "items": { "type": "string" } },
    "buy_links": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "url": { "type": "string" }
        }
      }
    },
    "google_books_id": { "type": "string" },
    "hardcover_id": { "type": "string" },
    "community_rating": { "type": "number" },
    "community_ratings_count": { "type": "number" },
    "enrichment_status": {
      "type": "string",
      "enum": ["enriched", "failed"]
    },
    "edited_fields": { "type": "array", "items": { "type": "string" } },
    "shelf_id": { "type": "string" },
    "shelf_ids": {
      "type": "array",
      "items": { "type": "string" },
      "description": "The other shelves this book is also on. A book has one main shelf (shelf_id), but an imported library keeps every custom shelf and list a book was filed on."
    },
    "status": {
      "type": "string",
      "enum": ["to_read", "reading", "read"],
      "default": "to_read"
    },
    "notes": {
      "type": "string",
      "description": "The reader's own private notes. They never leave the reader, not even to their reading circle."
    },
    "review": {
      "type": "string",
      "description": "What the reader thought of the book, in their own words."
    },
    "rating": { "type": "number" },
    "format": {
      "type": "string",
      "enum": ["paperback", "hardcover", "ebook", "kindle", "audiobook", "other"]
    },
    "formats": { "type": "array", "items": { "type": "string" } },
    "romance_subgenre": { "type": "string" },
    "spice": { "type": "number" },
    "spice_rating": { "type": "number" },
    "spice_shared": { "type": "boolean", "default": false },
    "content_warnings": { "type": "array", "items": { "type": "string" } },
    "share_enabled": { "type": "boolean", "default": false },
    "share_token": { "type": "string" },
    "share_audience": { "type": "string", "enum": ["circle", "selected"], "default": "circle" },
    "shared_with_ids": { "type": "array", "items": { "type": "string" } },
    "shared_with_names": { "type": "array", "items": { "type": "string" } }
  },
  "required": ["title", "shelf_id"]
}
