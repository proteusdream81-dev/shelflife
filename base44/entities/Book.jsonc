{
  "name": "Book",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "isbn": {
      "type": "string"
    },
    "asin": {
      "type": "string",
      "description": "The Kindle edition's own identifier, kept when an export carried one instead of an ISBN."
    },
    "cover_url": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "publisher": {
      "type": "string"
    },
    "published_date": {
      "type": "string"
    },
    "page_count": {
      "type": "number"
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "buy_links": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      }
    },
    "google_books_id": {
      "type": "string"
    },
    "hardcover_id": {
      "type": "string",
      "description": "The book's id at Hardcover, kept when that source contributed to it, so its cover art and editions can be asked for again."
    },
    "community_rating": {
      "type": "number",
      "description": "The average rating Hardcover's own readers gave this book. Shown as Hardcover's and kept apart from the reader's own rating."
    },
    "community_ratings_count": {
      "type": "number",
      "description": "How many Hardcover readers rated it, so an average is never shown without the number behind it."
    },
    "shelf_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "to_read",
        "reading",
        "read"
      ],
      "default": "to_read"
    },
    "notes": {
      "type": "string",
      "description": "The reader's own private notes. They never leave the reader, not even to their reading circle."
    },
    "review": {
      "type": "string",
      "description": "What the reader thought of the book, in their own words. It travels with the book to the readers their shelf is shared with, and nowhere else."
    },
    "rating": {
      "type": "number"
    },
    "format": {
      "type": "string",
      "enum": [
        "paperback",
        "hardcover",
        "ebook",
        "kindle",
        "audiobook",
        "other"
      ],
      "description": "The edition this reader holds. The same title may be held more than once, in different editions."
    },
    "formats": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Every format this title is held in, so a book owned as both a paperback and an audiobook answers to either when the list is filtered by format."
    },
    "series_name": {
      "type": "string"
    },
    "series_position": {
      "type": "string",
      "description": "Where the book sits in its series, kept as the catalogue gives it ('2', '2.5') so a series can be read in order."
    },
    "romance_subgenre": {
      "type": "string",
      "description": "The kind of romance this is - contemporary, dark, fantasy and so on - so romance reads are tagged properly rather than filed under one broad label."
    },
    "spice_rating": {
      "type": "number",
      "description": "The reader's own spice rating for this book, 0 to 5, with 0 meaning none. It belongs to their copy of the book, not to the title."
    },
    "spice_shared": {
      "type": "boolean",
      "default": false,
      "description": "True only when the reader has chosen to let their reading circle see this book's spice rating. Private unless they say otherwise."
    },
    "content_warnings": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Content warnings the reader tagged this book with - the common categories, plus any tag they wrote themselves."
    },
    "share_enabled": {
      "type": "boolean",
      "default": false
    },
    "share_token": {
      "type": "string",
      "description": "The token in this one book's shareable link. Cleared whenever the book stops being shared."
    },
    "share_audience": {
      "type": "string",
      "enum": [
        "circle",
        "selected"
      ],
      "default": "circle",
      "description": "Who a shared book is visible to: the reader's whole circle, or only the readers listed in shared_with_ids."
    },
    "shared_with_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "The chosen readers for a 'selected' share - the only people besides the owner who can see this book."
    },
    "shared_with_names": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Display names for shared_with_ids, kept in the same order."
    }
  },
  "required": [
    "title",
    "shelf_id"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}