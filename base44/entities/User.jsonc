{
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "profile_hidden": {
      "type": "boolean",
      "default": false,
      "description": "When true, this reader cannot be found by email and their shared shelves are hidden from the reading circle"
    },
    "username": {
      "type": "string",
      "description": "The reader's public @name, stored in lower case and unique across the app, so another reader can find them by typing it. Empty until they choose one in Settings."
    },
    "founding_tester_opted_in": {
      "type": "boolean",
      "default": false,
      "description": "True once the reader followed the Android closed-testing link from the Founding Tester banner, so the app stops asking them."
    },
    "tester_prompt_dismissed": {
      "type": "boolean",
      "default": false,
      "description": "True when the reader tapped 'Maybe later' on the Founding Tester banner. A deferral, not a refusal: the banner asks again on a later visit."
    }
  },
  "required": [
    "role"
  ],
  "name": "User",
  "type": "object"
}