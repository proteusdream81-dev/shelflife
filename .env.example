# Copy to .env.local for local development. Never commit .env.local.
# Firebase web-app values are public client configuration, not Admin credentials.
VITE_FIREBASE_PROJECT_ID=shelflife-tbr-9754d
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Server-side Firebase ID-token verification for Vercel.
# Set these in Vercel Project Settings -> Environment Variables as well.
# FIREBASE_WEB_API_KEY is the same public Firebase Web API key above; it is
# kept server-side here only to avoid coupling server code to Vite variables.
FIREBASE_PROJECT_ID=shelflife-tbr-9754d
FIREBASE_WEB_API_KEY=

# Existing Base44 settings remain required while the current app uses Base44.
VITE_BASE44_APP_ID=
VITE_BASE44_FUNCTIONS_VERSION=
VITE_BASE44_APP_BASE_URL=
