# Copy to .env.local for local development. Never commit .env.local.
# Firebase web-app values are public client configuration, not Admin credentials.
VITE_FIREBASE_PROJECT_ID=shelflife-tbr-9754d
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Server-only Firebase Admin SDK configuration for Vercel Preview.
# Google credentials are exchanged through Vercel OIDC; no private key is stored.
FIREBASE_PROJECT_ID=shelflife-tbr-9754d
GCP_PROJECT_NUMBER=599157455651
GCP_SERVICE_ACCOUNT_EMAIL=shelf-preview-auth@shelflife-tbr-9754d.iam.gserviceaccount.com
GCP_WORKLOAD_IDENTITY_POOL_ID=vercel-preview
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=shelflife-preview

# Existing Base44 settings remain required while the current app uses Base44.
VITE_BASE44_APP_ID=
VITE_BASE44_FUNCTIONS_VERSION=
VITE_BASE44_APP_BASE_URL=
